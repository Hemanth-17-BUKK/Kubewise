apiVersion: networking.k8s.io/v1
kind: Ingress

metadata:
  name: kubeai

spec:

  ingressClassName: nginx

  rules:

    - http:

        paths:

          - path: /cluster

            pathType: Prefix

            backend:

              service:

                name: cluster-service

                port:

                  number: 8001

          - path: /monitoring

            pathType: Prefix

            backend:

              service:

                name: monitoring-service

                port:

                  number: 8002

          - path: /installer

            pathType: Prefix

            backend:

              service:

                name: installer-service

                port:

                  number: 8003

          - path: /metrics

            pathType: Prefix

            backend:

              service:

                name: metric-service

                port:

                  number: 8004