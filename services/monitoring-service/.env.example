# AWS credentials are optional when using an AWS profile or IAM role.
# If you set credentials here, use short-lived credentials and never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS region used for STS and EKS calls.
AWS_REGION=us-east-1

# Name used when the service assumes a customer IAM role.
ROLE_SESSION_NAME=kubewise-session
